<?xml version="1.0" encoding="utf-8"?>
<labwc_config>
    <theme>
       <name>noctalia</name>
    </theme>
    <keyboard>
        <device>
            <layout>es</layout>
        </device>

        <keybind key="A-Tab">
          <action name="NextWindow" />
        </keybind>
        <keybind key="A-S-Tab">
          <action name="PreviousWindow" />
        </keybind>
        <keybind key="W-Return">
          <action name="Execute" command="ghostty" />
        </keybind>
        <keybind key="A-F4">
          <action name="Close" />
        </keybind>
        <keybind key="W-a">
          <action name="ToggleMaximize" />
        </keybind>

        <keybind key="A-Print">
          <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots; grim ~/Pictures/Screenshots/screenshot-$(date +%F-%H-%M-%S).png'" />
        </keybind>

        <keybind key="S-Print">
          <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots; grim -g &quot;$(slurp)&quot; ~/Pictures/Screenshots/screenshot-$(date +%F-%H-%M-%S).png'" />
        </keybind>

        <keybind key="C-S-Print">
          <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; - | wl-copy'" />
        </keybind>

        <keybind key="Print">
          <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots; grim -g &quot;$(slurp)&quot; - | satty --filename - --output-filename ~/Pictures/Screenshots/screenshot-$(date +%F-%H-%M-%S).png'" />
        </keybind>

    </keyboard>

    <desktops>
        <number>2</number>
        <names>
            <name>1</name>
            <name>2</name>
        </names>
    </desktops>

</labwc_config>
