{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
        "source": "/usr/share/logo/logo.png",
        "type": "kitty",
            },

  "display": {
    "color": "94",
    "separator": "    "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "  "

    },
    {
      "type": "custom",
      "format": " ────────────────────────────────"
    },
    {
      "type": "os",
      "key": "  "
    },
    {
      "type": "kernel",
      "key": "  "
    },
    {
      "type": "packages",
      "key": " 󰏗 "
    },
    {
      "type": "cpu",
      "key": "  ",
      "format": "{}"
    },
    {
      "type": "gpu",
      "key": "  ",
      "format": "{1}, {3}"
    },
    {
      "type": "memory",
      "key": " 󰟖 ",
      "format": "{1} / {2}"
    },
    {
      "type": "disk",
      "key": "  ",
      "format": "{1} / {2}"
    },
         {
  "type": "de",
    "key": "  ",
     },
    {
      "type": "wm",
      "key": " 󰖯 ",
      "format": "{}"
    },
    {
      "type": "terminal",
      "key": "  "
    },
    {
      "type": "shell",
      "key": "  "
    },
    {
      "type": "uptime",
      "key": " 󰥔 "
    },
    {
      "type": "custom",
      "format": " ────────────────────────────────"
    },
    {
      "type": "custom",
      "format": " {#30}⬤ {#90}⬤ {#31}⬤ {#91}⬤ {#32}⬤ {#92}⬤ {#33}⬤ {#93}⬤ {#34}⬤ {#94}⬤ {#35}⬤ {#95}⬤ {#36}⬤ {#96}⬤ {#37}⬤ {#97}⬤ "
    },
  ]
}
