// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    environment {
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        QT_QPA_PLATFORM "wayland"
        QT_QPA_PLATFORMTHEME "qt6ct"
        //QT_QPA_PLATFORMTHEME "qt5ct:qt6ct"
        //QT_STYLE_OVERRIDE "kvantum"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
        XDG_CURRENT_DESKTOP "niri"
        XDG_SESSION_TYPE "wayland"
        //Esto es necesario para que en dolphin ofrezca las apps para abrir un archivo
        //XDG_MENU_PREFIX "plasma-"
    }

    //spawn-at-startup "dbus-update-activation-environment" "WAYLAND_DISPLAY" "DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE" "XDG_SESSION_TYPE" "DBUS_SESSION_BUS_ADDRESS" "QT_QPA_PLATFORM" "QT_QPA_PLATFORMTHEME" "QT_WAYLAND_DISABLE_WINDOWDECORATION" "ELECTRON_OZONE_PLATFORM_HINT" "XDG_MENU_PREFIX"

    spawn-at-startup "dbus-update-activation-environment" "-all"

    //Para que dolphin tenga las aplicaciones predeterminadas
    //spawn-at-startup "kbuildsycoca6" "--noincremental"
    spawn-at-startup "udiskie" "--automount" "--notify"
    spawn-at-startup "pipewire"
    spawn-at-startup "xdg-user-dirs-update"
    //spawn-at-startup "sh" "-c" "pkill -f xdg-desktop-portal"
    //spawn-sh-at-startup "/usr/lib/pam_kwallet_init"
    spawn-at-startup "noctalia"

